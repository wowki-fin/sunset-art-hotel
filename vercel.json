{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.sunsetarthotel.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "sunset-art-hotel.vercel.app"
        }
      ]
    },
    { "source": "/bg/book-online", "destination": "https://www.sunsetarthotel.com/", "permanent": true },
    { "source": "/en/book-online", "destination": "https://www.sunsetarthotel.com/", "permanent": true },
    { "source": "/es/book-online", "destination": "https://www.sunsetarthotel.com/", "permanent": true },
    { "source": "/book-online",    "destination": "https://www.sunsetarthotel.com/", "permanent": true }
  ]
}
